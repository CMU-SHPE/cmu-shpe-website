# Copy to .env.local and fill in. Never commit real values.

# Neon Postgres connection string (pooled), used by the site and the db:* scripts.
DATABASE_URL=

# Random secret that signs admin session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Local `next start` only: set to true so sign-in works on localhost. Vercel trusts its host automatically.
AUTH_TRUST_HOST=

# Master admin account: created by `npm run db:seed`, moved or recovered by `npm run db:reset-master`.
# Single-quote the password (MASTER_PASSWORD='...') or a `#` and everything after it is dropped; don't use `'` in it.
MASTER_EMAIL=
MASTER_PASSWORD=

# Vercel Blob read/write token for sponsor, officer and advisor image uploads.
BLOB_READ_WRITE_TOKEN=

# Resend API key used to send account emails (confirmation, password reset) and newsletters.
RESEND_API_KEY=

# Verified Resend sending domain (e.g. news.shpecmu.com); account emails go out from hello@<this domain>,
# newsletters from news@<this domain>.
RESEND_EMAIL_DOMAIN=

# Optional https origin for links in emails (e.g. https://example.com). Leave unset on Vercel, or set it for Production only;
# previews use their own URL. Needed for a local `next start`, where http://localhost:3000 is allowed.
SITE_URL=
